# =============================================================================
# CNPJ Consulta - configuracao de exemplo
# Copie para .env e ajuste conforme necessario
# =============================================================================

# Ambiente: development | production
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
# Contato exibido na pagina de privacidade (LGPD)
APP_CONTACT_EMAIL=

# Porta do servidor web. Mantenha 127.0.0.1: o app nao tem login.
# Em APP_ENV=production (ou APP_DEBUG=false), host nao-loopback e recusado.
APP_PORT=8000
APP_HOST=127.0.0.1

# Banco SQLite principal (historico, cache, favoritos)
DATABASE_URL=sqlite:///./data/app.db

# Cache: memory | sqlite (sqlite persiste entre reinicializacoes). TTL em segundos (24h)
CACHE_BACKEND=sqlite
CACHE_TTL_SECONDS=86400

# HTTP: timeout por requisicao, retentativas (so para erro 5xx/rede) e
# tempo maximo de espera por TODAS as fontes juntas em uma consulta.
REQUEST_TIMEOUT_SECONDS=10
REQUEST_MAX_RETRIES=2
REQUEST_BACKOFF_SECONDS=1.0
REQUEST_TOTAL_TIMEOUT_SECONDS=20

# Limite de consultas de empresa por minuto POR IP (API + pagina /empresa).
INBOUND_RATE_LIMIT_PER_MINUTE=30

# Limite local de consultas por minuto, por fonte. Ao atingir, a fonte e
# pulada (aparece como "limite atingido") em vez de atrasar a consulta.
RATE_LIMIT_BRASILAPI=60
RATE_LIMIT_MINHA_RECEITA=30
RATE_LIMIT_CNPJWS=3
RATE_LIMIT_RECEITAWS=3

# -----------------------------------------------------------------------------
# Provedores habilitados
# -----------------------------------------------------------------------------
BRASILAPI_ENABLED=true
BRASILAPI_BASE_URL=https://brasilapi.com.br/api/cnpj/v1

MINHA_RECEITA_ENABLED=true
MINHA_RECEITA_BASE_URL=https://minhareceita.org

CNPJWS_ENABLED=false
CNPJWS_BASE_URL=https://publica.cnpj.ws

# Opt-in: Clausula Oitava do ReceitaWS proibe republicacao via API publica.
# Deixe false salvo uso pessoal estritamente local.
RECEITAWS_ENABLED=false
RECEITAWS_BASE_URL=https://www.receitaws.com.br/v1

# Base local da Receita Federal (dados abertos do CNPJ): ficha completa,
# busca avancada, busca por socio, filiais e funcionamento offline.
# Instale/atualize pelo painel "Base de Dados CNPJ" (/base) ou com
# `python -m app.cli base atualizar`. Reserve ~45 GB livres durante a
# atualizacao; cada versao publicada ocupa ~15 GB (ficam a ativa e a anterior).
RECEITA_LOCAL_ENABLED=true
RECEITA_DATA_DIR=./data/receita
# Ponto de entrada oficial. O link do compartilhamento e a pasta do CNPJ sao
# descobertos a partir dele (sem URL fixa de arquivo).
RECEITA_PORTAL_URL=https://arquivos.receitafederal.gov.br/
RECEITA_PASTA_CNPJ=Dados/Cadastros/CNPJ
# So se a descoberta automatica falhar (token do link publico /s/<token>):
RECEITA_SHARE_TOKEN=
# Memoria maxima do DuckDB na importacao (o excedente vai para disco).
RECEITA_DUCKDB_MEMORIA=4GB
RECEITA_DUCKDB_THREADS=0
RECEITA_MANTER_ZIPS=false
RECEITA_VERSOES_MANTIDAS=2
# Recusa publicar se uma tabela encolher mais que isto (arquivo truncado na origem)
RECEITA_QUEDA_MAXIMA_PCT=10
RECEITA_ORFAOS_MAX_PCT=5
# Consulta a base local primeiro; fontes externas so quando pedido.
RECEITA_LOCAL_PRIMEIRO=true
# Base avulsa no formato antigo (usada so se nao houver versao publicada)
RECEITA_LOCAL_PATH=./data/receita/receita.db

# Area administrativa (/base, contatos complementares, auditoria).
# Vazio = token gerado em data/admin_token.txt no primeiro uso
# (veja com `python -m app.cli admin-token`).
ADMIN_TOKEN=
ADMIN_SESSAO_HORAS=8

# Servidor MCP (assistentes de IA): ferramentas que alteram dados (atualizar a
# base, contatos complementares) so aparecem com true. Ver MCP.md.
MCP_PERMITIR_ADMIN=false

# Busca avancada e exportacao
BUSCA_TIMEOUT_SEGUNDOS=30
BUSCA_MAX_POR_PAGINA=100
EXPORTACAO_MAX_LINHAS=500000
EXPORTACAO_SINCRONA_MAX=20000

# Contatos complementares (fora da Receita): prazo para marcar como
# desatualizado e para descarte por retencao (LGPD).
CONTATOS_DESATUALIZADO_DIAS=365
CONTATOS_RETENCAO_DIAS=730

# -----------------------------------------------------------------------------
# Pesquisa na internet (opcional)
# -----------------------------------------------------------------------------
# Sem provedor, a aba "Pesquisa na internet" mostra so os atalhos (links prontos
# para buscadores, Jusbrasil, certidoes, mapas...). Com provedor, os resultados
# aparecem na propria tela -- a busca so parte quando voce clica em "Pesquisar"
# e usa apenas dados da empresa (nunca nomes de socios).
#   tavily : 1.000 buscas/mes gratis, sem cartao (https://tavily.com)
#   brave  : Brave Search API; credito mensal de US$ 5 (exige atribuicao, ja exibida)
#   searxng: sua propria instancia SearXNG (habilite "json" em search.formats)
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_URL=
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_CACHE_SECONDS=3600

# Sancoes federais (CEIS, CNEP, CEPIM, CEAF) no checklist de diligencia.
# Chave gratuita: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=
PORTAL_TRANSPARENCIA_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados

# Consulta em lote: maximo de CNPJs por pedido
BATCH_MAX_ITEMS=30

# -----------------------------------------------------------------------------
# Inscricao estadual direto no app (opcional)
# -----------------------------------------------------------------------------
# Com o certificado digital A1 (e-CNPJ, arquivo .pfx) do escritorio, o app
# consulta o web service oficial de consulta cadastral da SEFAZ (o mesmo
# cadastro do portal CCC). Sem certificado, a pagina "Inscricao estadual" abre
# o portal CCC (https://dfe-portal.svrs.rs.gov.br/NFE/CCC), que exige login gov.br.
# A senha fica so neste arquivo local; nunca e exibida nem registrada em log.
CERTIFICADO_A1_PATH=
CERTIFICADO_A1_SENHA=
# Cadeia de CAs extra (ex.: ICP-Brasil) se alguma SEFAZ der erro de TLS
SEFAZ_CA_BUNDLE=
