# =============================================================================
# CNPJ Consulta - configuracao de exemplo
# Copie para .env e ajuste conforme necessario
# =============================================================================

# Ambiente: development | production
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
# Contato exibido na pagina de privacidade (LGPD)
APP_CONTACT_EMAIL=

# Porta do servidor web. Mantenha 127.0.0.1: o app nao tem login.
APP_PORT=8000
APP_HOST=127.0.0.1

# Banco SQLite principal (historico, cache, favoritos)
DATABASE_URL=sqlite:///./data/app.db

# Cache: memory | sqlite (sqlite persiste entre reinicializacoes). TTL em segundos (24h)
CACHE_BACKEND=sqlite
CACHE_TTL_SECONDS=86400

# HTTP: timeout por requisicao, retentativas (so para erro 5xx/rede) e
# tempo maximo de espera por TODAS as fontes juntas em uma consulta.
REQUEST_TIMEOUT_SECONDS=10
REQUEST_MAX_RETRIES=2
REQUEST_BACKOFF_SECONDS=1.0
REQUEST_TOTAL_TIMEOUT_SECONDS=20

# Limite local de consultas por minuto, por fonte. Ao atingir, a fonte e
# pulada (aparece como "limite atingido") em vez de atrasar a consulta.
RATE_LIMIT_BRASILAPI=60
RATE_LIMIT_MINHA_RECEITA=30
RATE_LIMIT_CNPJWS=3
RATE_LIMIT_RECEITAWS=3

# -----------------------------------------------------------------------------
# Provedores habilitados
# -----------------------------------------------------------------------------
BRASILAPI_ENABLED=true
BRASILAPI_BASE_URL=https://brasilapi.com.br/api/cnpj/v1

MINHA_RECEITA_ENABLED=true
MINHA_RECEITA_BASE_URL=https://minhareceita.org

CNPJWS_ENABLED=false
CNPJWS_BASE_URL=https://publica.cnpj.ws

RECEITAWS_ENABLED=true
RECEITAWS_BASE_URL=https://www.receitaws.com.br/v1

# Base local da Receita Federal (busca por socio, filiais, modo offline).
# Rode `python -m app.cli sync-receita --mes AAAA-MM` e depois mude para true.
RECEITA_LOCAL_ENABLED=false
RECEITA_LOCAL_PATH=./data/receita/receita.db

# Diretorio dos dados abertos do CNPJ; os ZIPs ficam em {URL}/{AAAA-MM}/.
# Se a Receita mudar o endereco, ajuste aqui (sem alterar codigo).
RECEITA_BASE_URL=https://arquivos.receitafederal.gov.br/dados/cnpj/dados_abertos_cnpj
